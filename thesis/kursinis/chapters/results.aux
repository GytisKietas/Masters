\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Shape of the inflationary potential $V(\phi )=V_0\exp \!\left [-\kappa \exp \!\left (\phi /(bM_{\rm  pl})\right )\right ]$. The plot was generated in this work to illustrate the nearly flat region at small $\phi $ (supporting slow-roll inflation) followed by a rapid drop, which strongly affects the inflaton dynamics and the end of inflation.}}{17}{figure.caption.6}\protected@file@percent }
\newlabel{fig:potential}{{5}{17}{Shape of the inflationary potential $V(\phi )=V_0\exp \!\left [-\kappa \exp \!\left (\phi /(bM_{\rm pl})\right )\right ]$. The plot was generated in this work to illustrate the nearly flat region at small $\phi $ (supporting slow-roll inflation) followed by a rapid drop, which strongly affects the inflaton dynamics and the end of inflation}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Illustration of the evolution of the inflaton field. After slow-roll rolling along the blue direction (stage 1), the field reaches the SBP and resonantly excites $\chi $, generating an effective linear potential and amplifying metric perturbations (stage 2). When resonance ends, the system rolls along the waterfall potential (brown) with $\phi =\phi _{\rm  SBP}$. This illustration is from \cite  {karciauskas2025primordial}}}{18}{figure.caption.7}\protected@file@percent }
\newlabel{fig:potential illustration}{{6}{18}{Illustration of the evolution of the inflaton field. After slow-roll rolling along the blue direction (stage 1), the field reaches the SBP and resonantly excites $\chi $, generating an effective linear potential and amplifying metric perturbations (stage 2). When resonance ends, the system rolls along the waterfall potential (brown) with $\phi =\phi _{\rm SBP}$. This illustration is from \cite {karciauskas2025primordial}}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Analytic slow-roll solution $\phi (N)$ as a function of the number of e-folds $N=\ln a$ for the exponential-to-exponential potential. This curve was plotted in this work from the derived closed-form expression and demonstrates the characteristic gradual evolution of the inflaton during the slow-roll phase.}}{20}{figure.caption.8}\protected@file@percent }
\newlabel{fig:slowroll}{{7}{20}{Analytic slow-roll solution $\phi (N)$ as a function of the number of e-folds $N=\ln a$ for the exponential-to-exponential potential. This curve was plotted in this work from the derived closed-form expression and demonstrates the characteristic gradual evolution of the inflaton during the slow-roll phase}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}Numerical calculations}{21}{subsection.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Numerical evolution of the inflaton field $\phi (N)$ obtained in this work using a fixed-step RK4 integrator. The solution shows the expected rapid growth in the chosen model, and inflation terminates at $N_{\rm  end}\approx 12.59$ as determined by the condition $\epsilon =1$.}}{22}{figure.caption.9}\protected@file@percent }
\newlabel{fig:phievolition}{{8}{22}{Numerical evolution of the inflaton field $\phi (N)$ obtained in this work using a fixed-step RK4 integrator. The solution shows the expected rapid growth in the chosen model, and inflation terminates at $N_{\rm end}\approx 12.59$ as determined by the condition $\epsilon =1$}{figure.caption.9}{}}
\babel@aux{english}{}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Comoving particle production indicator $\ln n_k$ obtained numerically in this work during the evolution of the inflaton-only system. The step-like increase with intermediate jumps is a coordinate artifact of using comoving variables; a more physical treatment including the coupled $\chi $ and $\theta $ fields would introduce backreaction and effective friction, modifying both the inflaton evolution and particle production rate.}}{22}{figure.caption.10}\protected@file@percent }
\newlabel{fig:particle_production_phi}{{9}{22}{Comoving particle production indicator $\ln n_k$ obtained numerically in this work during the evolution of the inflaton-only system. The step-like increase with intermediate jumps is a coordinate artifact of using comoving variables; a more physical treatment including the coupled $\chi $ and $\theta $ fields would introduce backreaction and effective friction, modifying both the inflaton evolution and particle production rate}{figure.caption.10}{}}
